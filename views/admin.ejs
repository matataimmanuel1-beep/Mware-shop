<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Admin Hub - Mware Shop</title>
    <style>
        body { background: #0f172a; color: #f8fafc; font-family: sans-serif; margin: 0; padding: 30px; }
        .head { display: flex; justify-content: space-between; border-bottom: 1px solid #334155; padding-bottom: 15px; margin-bottom: 25px; }
        .grid { display: grid; grid-template-columns: 1fr 2fr; gap: 30px; margin-bottom: 25px; }
        .panel { background: #1e293b; border: 1px solid #334155; padding: 20px; border-radius: 10px; }
        h3 { margin-top: 0; border-bottom: 1px solid #334155; padding-bottom: 8px; color: #fbbf24; }
        .group { margin-bottom: 10px; }
        label { display: block; font-size: 11px; color: #94a3b8; margin-bottom: 3px; }
        input, select { width: 100%; box-sizing: border-box; padding: 8px; background: #334155; border: 1px solid #475569; border-radius: 4px; color: white; }
        .btn { width: 100%; padding: 10px; background: #4f46e5; border: none; color: white; font-weight: bold; border-radius: 4px; cursor: pointer; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { text-align: left; padding: 8px; color: #94a3b8; border-bottom: 1px solid #334155; }
        td { padding: 10px 8px; border-bottom: 1px solid #334155; }
        .action { background: #334155; color: white; border: none; padding: 3px 6px; border-radius: 4px; cursor: pointer; font-size: 11px; }
    </style>
</head>
<body>
    <div class="head">
        <h2>MWARE SHOP ADMINISTRATOR CONTROL PANEL</h2>
        <a href="/" style="background:#334155; color:white; padding:8px 12px; border-radius:4px; text-decoration:none; font-size:13px;">View Storefront</a>
    </div>

    <div class="grid">
        <div class="panel">
            <h3>Add New Product</h3>
            <form action="/admin/product/add" method="POST" enctype="multipart/form-data">
                <div class="group"><label>Product Name</label><input type="text" name="name" required></div>
                <div class="group" style="display:flex; gap:10px;">
                    <div style="flex:2;"><label>Price</label><input type="number" step="0.01" name="price" required></div>
                    <div style="flex:1;"><label>Currency</label><input type="text" name="currency" value="USD" required></div>
                </div>
                <div class="group"><label>Stock Allocation</label><select name="status"><option value="In Stock">In Stock</option><option value="Out of Stock">Out of Stock</option></select></div>
                <div class="group"><label>Upload Image</label><input type="file" name="image" accept="image/*"></div>
                <button type="submit" class="btn" style="background:#6366f1;">Deploy Product</button>
            </form>
        </div>

        <div class="panel">
            <h3>Live Catalog Controls</h3>
            <table>
                <thead><tr><th>Item Name</th><th>Price Matrix</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
                <tbody>
                    <% products.forEach(p => { %>
                        <tr>
                            <td><strong><%= p.name %></strong></td>
                            <td style="font-family:monospace; color:#818cf8;"><%= p.price %> <%= p.currency %></td>
                            <td><span style="color: <%= p.status === 'In Stock' ? '#4ade80' : '#f87171' %>;"><%= p.status %></span></td>
                            <td style="text-align:right;">
                                <form action="/admin/product/toggle/<%= p.id %>" method="POST" style="display:inline;"><button type="submit" class="action">Toggle Stock</button></form>
                                <form action="/admin/product/delete/<%= p.id %>" method="POST" style="display:inline;"><button type="submit" class="action" style="background:#991b1b;">Delete</button></form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="grid">
        <div class="panel">
            <h3>Edit Store Contact Matrix</h3>
            <form action="/admin/contact/update" method="POST">
                <div class="group"><label>Telephone Route</label><input type="text" name="phone" value="<%= contactInfo.phone %>" required></div>
                <div class="group"><label>Support Email</label><input type="email" name="email" value="<%= contactInfo.email %>" required></div>
                <div class="group"><label>HQ Location Address</label><input type="text" name="address" value="<%= contactInfo.address %>" required></div>
                <button type="submit" class="btn" style="background:#10b981;">Commit Global Contacts</button>
            </form>
        </div>

        <div class="panel">
            <h3>Customer Accounts Matrix & Overrides</h3>
            <table>
                <thead><tr><th>Email Anchor</th><th>Phone Anchor</th><th>Password Value</th><th>Credential Override Action</th></tr></thead>
                <tbody>
                    <% accounts.forEach(acc => { %>
                        <tr>
                            <td><%= acc.email %></td>
                            <td><%= acc.phone %></td>
                            <td style="font-family:monospace; color:#fbbf24;"><%= acc.password %></td>
                            <td>
                                <form action="/admin/accounts/modify" method="POST" style="display:flex; gap:5px;">
                                    <input type="hidden" name="targetEmail" value="<%= acc.email %>">
                                    <input type="text" name="updatedPassword" placeholder="New Password" required style="padding:4px; font-size:11px;">
                                    <button type="submit" class="action" style="background:#d97706;">Save Change</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
