<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Admin Command Centre - Mware Shop</title>
    <script src="https://tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen font-sans p-6">
    <div class="max-w-6xl mx-auto space-y-8">
        <div class="flex justify-between items-center border-b border-slate-700 pb-4">
            <h1 class="text-3xl font-black text-amber-400 tracking-wide">MWARE SHOP CONTROL PANEL</h1>
            <a href="/" class="bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded text-sm font-semibold">Back to Storefront</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Product Creator Module -->
            <section class="bg-slate-800 p-6 rounded-xl border border-slate-700 space-y-4">
                <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-2">Add New Product</h2>
                <form action="/admin/product/add" method="POST" enctype="multipart/form-data" class="space-y-3">
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">Product Title</label>
                        <input type="text" name="name" required class="w-full bg-slate-700 border border-slate-600 rounded p-2 text-sm text-white">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-xs text-slate-400 block mb-1">Price</label>
                            <input type="number" step="0.01" name="price" required class="w-full bg-slate-700 border border-slate-600 rounded p-2 text-sm text-white">
                        </div>
                        <div>
                            <label class="text-xs text-slate-400 block mb-1">Currency</label>
                            <input type="text" name="currency" value="USD" required class="w-full bg-slate-700 border border-slate-600 rounded p-2 text-sm text-white">
                        </div>
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">Initial Inventory Status</label>
                        <select name="status" class="w-full bg-slate-700 border border-slate-600 rounded p-2 text-sm text-white">
                            <option value="In Stock">In Stock</option>
                            <option value="Out of Stock">Out of Stock</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">Product Photo</label>
                        <input type="file" name="image" accept="image/*" class="w-full text-xs text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-indigo-600 file:text-white hover:file:bg-indigo-700 cursor-pointer">
                    </div>
                    <button type="submit" class="w-full py-2 bg-indigo-600 hover:bg-indigo-700 text-sm font-bold rounded transition">Deploy Product</button>
                </form>
            </section>

            <!-- Inventory Manager Module -->
            <section class="bg-slate-800 p-6 rounded-xl border border-slate-700 md:col-span-2 space-y-4">
                <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-2">Live Inventory Ecosystem</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-300">
                        <thead>
                            <tr class="text-slate-400 uppercase text-xs border-b border-slate-700">
                                <th class="py-2">Item</th>
                                <th>Value</th>
                                <th>Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700">
                            <% products.forEach(p => { %>
                                <tr class="align-middle">
                                    <td class="py-3 font-semibold text-white"><%= p.name %></td>
                                    <td class="font-mono text-indigo-400"><%= p.price %> <%= p.currency %></td>
                                    <td>
                                        <span class="px-2 py-0.5 rounded text-xs font-bold <%= p.status === 'In Stock' ? 'bg-green-950 text-green-400' : 'bg-red-950 text-red-400' %>"><%= p.status %></span>
                                    </td>
                                    <td class="text-right space-x-2">
                                        <form action="/admin/product/toggle/<%= p.id %>" method="POST" class="inline">
                                            <button class="text-xs bg-slate-700 hover:bg-slate-600 px-2 py-1 rounded transition">Toggle Status</button>
                                        </form>
                                        <form action="/admin/product/delete/<%= p.id %>" method="POST" class="inline">
                                            <button class="text-xs bg-red-900/50 hover:bg-red-900 text-red-400 px-2 py-1 rounded transition">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- Global Content / Contact Manager Module -->
        <section class="bg-slate-800 p-6 rounded-xl border border-slate-700">
            <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-2 mb-4">Edit Global Storefront Contact Matrix</h2>
            <form action="/admin/contact/update" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="text-xs text-slate-400 block mb-1">Telephone Route</label>
                    <input type="text" name="phone" value="<%= contactInfo.phone %>" required class="w-full bg-slate-700 border border-slate-600 rounded p-2 text-sm text-white">
                </div>
                <div>
                    <label class="text-xs text-slate-400 block mb-1">Public Support Email</label>
                    <input type="email" name="email" value="<%= contactInfo.email %>" required class="w-full bg-slate-700 border border-slate-600 rounded p-2 text-sm text-white">
                </div>
                <div>
                    <label class="text-xs text-slate-400 block mb-1">Physical HQ Address</label>
                    <input type="text" name="address" value="<%= contactInfo.address %>" required class="w-full bg-slate-700 border border-slate-600 rounded p-2 text-sm text-white">
                </div>
                <div class="md:col-span-3 text-right">
                    <button type="submit" class="px-6 py-2 bg-emerald-600 hover:bg-emerald-700 text-sm font-bold rounded transition">Commit Info Update</button>
                </div>
            </form>
        </section>
    </div>
</body>
</html>

