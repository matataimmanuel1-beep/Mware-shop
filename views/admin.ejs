<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard - Mware Shop</title>
    <style>
        body { background: #0f172a; color: #f8fafc; font-family: sans-serif; margin: 0; padding: 30px; }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; padding-bottom: 15px; margin-bottom: 30px; }
        h1 { color: #fbbf24; margin: 0; font-size: 26px; }
        .back-link { background: #334155; color: #fff; padding: 8px 15px; border-radius: 6px; text-decoration: none; font-size: 14px; }
        .layout { display: grid; grid-template-columns: 1fr 2fr; gap: 30px; margin-bottom: 30px; }
        @media(max-width:768px){ .layout { grid-template-columns:1fr; } }
        .box { background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 20px; }
        h2 { margin-top: 0; font-size: 18px; color: #fff; border-bottom: 1px solid #334155; padding-bottom: 10px; margin-bottom: 15px; }
        .form-group { margin-bottom: 12px; }
        label { display: block; font-size: 12px; color: #94a3b8; margin-bottom: 4px; }
        input, select { width: 100%; box-sizing: border-box; padding: 8px; background: #334155; border: 1px solid #475569; border-radius: 4px; color: #fff; }
        .btn-submit { width: 100%; padding: 10px; background: #6366f1; border: none; color: #fff; font-weight: bold; border-radius: 4px; cursor: pointer; margin-top: 10px; }
        table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
        th { color: #94a3b8; padding: 10px; border-bottom: 1px solid #334155; font-size: 12px; text-transform: uppercase; }
        td { padding: 12px 10px; border-bottom: 1px solid #1e293b; }
        .badge { padding: 2px 6px; font-size: 11px; font-weight: bold; border-radius: 4px; background: #064e3b; color: #34d399; }
        .badge.out { background: #7f1d1d; color: #f87171; }
        .action-btn { background: #334155; color: white; border: none; padding: 4px 8px; font-size: 12px; border-radius: 4px; cursor: pointer; }
        .btn-delete { background: #991b1b; color: #fca5a5; }
    </style>
</head>
<body>
    <div class="header">
        <h1>MWARE SHOP CONTROL PANEL</h1>
        <a href="/" class="back-link">Back to Storefront</a>
    </div>

    <div class="layout">
        <div class="box">
            <h2>Add New Product</h2>
            <form action="/admin/product/add" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label>Product Title</label>
                    <input type="text" name="name" required>
                </div>
                <div style="display:flex; gap:10px;" class="form-group">
                    <div style="flex:1;">
                        <label>Price</label>
                        <input type="number" step="0.01" name="price" required>
                    </div>
                    <div style="width:80px;">
                        <label>Currency</label>
                        <input type="text" name="currency" value="USD" required>
                    </div>
                </div>
                <div class="form-group">
                    <label>Inventory Status</label>
                    <select name="status">
                        <option value="In Stock">In Stock</option>
                        <option value="Out of Stock">Out of Stock</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Product Image File</label>
                    <input type="file" name="image" accept="image/*">
                </div>
                <button type="submit" class="btn-submit">Deploy Product</button>
            </form>
        </div>

        <div class="box">
            <h2>Live Inventory Ecosystem</h2>
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Value</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(p => { %>
                        <tr>
                            <td style="color:white; font-weight:bold;"><%= p.name %></td>
                            <td style="font-family:monospace; color:#818cf8;"><%= p.price %> <%= p.currency %></td>
                            <td><span class="badge <%= p.status !== 'In Stock' ? 'out' : '' %>"><%= p.status %></span></td>
                            <td style="text-align:right;">
                                <form action="/admin/product/toggle/<%= p.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="action-btn">Toggle Status</button>
                                </form>
                                <form action="/admin/product/delete/<%= p.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="action-btn btn-delete">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="box">
        <h2>Edit Global Storefront Contact Matrix</h2>
        <form action="/admin/contact/update" method="POST" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap:20px;">
            <div class="form-group">
                <label>Telephone Route</label>
                <input type="text" name="phone" value="<%= contactInfo.phone %>" required>
            </div>
            <div class="form-group">
                <label>Public Support Email</label>
                <input type="email" name="email" value="<%= contactInfo.email %>" required>
            </div>
            <div class="form-group">
                <label>Physical HQ Address</label>
                <input type="text" name="address" value="<%= contactInfo.address %>" required>
            </div>
            <div style="grid-column: 1 / -1; text-align: right;">
                <button type="submit" class="btn-submit" style="width:auto; padding:10px 30px; background:#10b981;">Commit Info Update</button>
            </div>
        </form>
    </div>
</body>
</html>
