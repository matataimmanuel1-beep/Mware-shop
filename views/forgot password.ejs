<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Forgot Password - Mware Shop</title>
    <style>
        body { background: #0f172a; color: #f8fafc; font-family: sans-serif; margin: 0; padding: 40px 20px; }
        .container { max-width: 420px; margin: 40px auto; background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 30px; }
        h1 { text-align: center; color: #fbbf24; }
        .form-group { margin-bottom: 18px; }
        label { display: block; font-size: 13px; margin-bottom: 5px; color: #94a3b8; font-weight: bold; }
        input { width: 100%; box-sizing: border-box; padding: 12px; background: #334155; border: 1px solid #475569; border-radius: 6px; color: white; }
        .btn { width: 100%; padding: 14px; background: #10b981; border: none; color: white; font-weight: bold; border-radius: 8px; cursor: pointer; }
        .alert { padding: 12px; border-radius: 6px; margin-bottom: 15px; text-align: center; }
        .success { background: rgba(34,197,94,0.2); color: #4ade80; }
        .error { background: rgba(239,68,68,0.2); color: #f87171; }
        .code-box { background: #0f172a; padding: 15px; border-radius: 8px; text-align: center; margin: 15px 0; font-size: 24px; font-weight: bold; letter-spacing: 4px; color: #fbbf24; }
        a { color: #60a5fa; }
        .links { text-align: center; margin-top: 20px; font-size: 14px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🔑 Reset Password</h1>

        <% if (message) { %>
            <div class="alert <%= success ? 'success' : 'error' %>"><%= message %></div>
        <% } %>

        <% if (generatedCode) { %>
            <div class="code-box"><%= generatedCode %></div>
            <p style="text-align:center; font-size:13px; color:#94a3b8;">Use this code below to reset your password</p>
        <% } %>

        <!-- Step 1: Request Code -->
        <form action="/forgot-password" method="POST" style="margin-bottom: 30px;">
            <input type="hidden" name="action" value="request">
            <div class="form-group">
                <label>Your Email</label>
                <input type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
            </div>
            <button type="submit" class="btn" style="background:#6366f1;">Generate Verification Code</button>
        </form>

        <hr style="border-color:#334155; margin: 25px 0;">

        <!-- Step 2: Reset with Code -->
        <form action="/forgot-password" method="POST">
            <input type="hidden" name="action" value="reset">
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
            </div>
            <div class="form-group">
                <label>Verification Code</label>
                <input type="text" name="verificationCode" placeholder="6-digit code" required>
            </div>
            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="newPassword" required>
            </div>
            <button type="submit" class="btn">Reset Password</button>
        </form>

        <div class="links">
            <p><a href="/login">← Back to Login</a></p>
        </div>
    </div>
</body>
</html>
