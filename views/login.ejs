<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login - Mware Shop</title>
    <style>
        body { background: #0f172a; color: #f8fafc; font-family: sans-serif; margin: 0; padding: 40px 20px; }
        .container { max-width: 420px; margin: 40px auto; background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 30px; box-shadow: 0 10px 15px rgba(0,0,0,0.3); }
        h1 { text-align: center; color: #fbbf24; margin-bottom: 20px; }
        .form-group { margin-bottom: 18px; text-align: left; }
        label { display: block; font-size: 13px; margin-bottom: 5px; color: #94a3b8; font-weight: bold; }
        input, select { width: 100%; box-sizing: border-box; padding: 12px; background: #334155; border: 1px solid #475569; border-radius: 6px; color: white; font-family: inherit; }
        .btn { width: 100%; padding: 14px; background: #4f46e5; border: none; color: white; font-weight: bold; font-size: 16px; border-radius: 8px; cursor: pointer; }
        .btn:hover { background: #6366f1; }
        .alert { background: rgba(234,179,8,0.2); color: #fbbf24; padding: 10px; border-radius: 6px; margin-bottom: 15px; text-align: center; }
        a { color: #60a5fa; text-decoration: none; }
        .links { text-align: center; margin-top: 20px; font-size: 14px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🔑 Login</h1>

        <% if (message) { %>
            <div class="alert"><%= message %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="you@example.com" required>
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" required>
            </div>
            <button type="submit" class="btn">Sign In</button>
        </form>

        <div class="links">
            <p>Don't have an account? <a href="/register">Register as Customer</a></p>
            <p><a href="/">← Back to Shop</a></p>
        </div>
    </div>
</body>
</html>
