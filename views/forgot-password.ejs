<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Mware Shop</title>
    <style>
        body { background: #0f172a; color: #f8fafc; font-family: sans-serif; margin: 0; padding: 40px 20px; }
        .container { max-width: 420px; margin: 40px auto; background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 30px; }
        .logo-wrap { text-align: center; margin-bottom: 20px; }
        .logo-wrap img { height: 60px; width: auto; border-radius: 10px; }
        h1 { text-align: center; color: #fbbf24; }
        .subtitle { text-align: center; color: #94a3b8; font-size: 14px; margin-bottom: 25px; }
        .form-group { margin-bottom: 18px; }
        label { display: block; font-size: 13px; margin-bottom: 5px; color: #94a3b8; font-weight: bold; }
        input { width: 100%; box-sizing: border-box; padding: 12px; background: #334155; border: 1px solid #475569; border-radius: 6px; color: white; }
        .btn { width: 100%; padding: 14px; background: #10b981; border: none; color: white; font-weight: bold; border-radius: 8px; cursor: pointer; }
        .btn-secondary { background: #6366f1; margin-bottom: 10px; }
        .alert { padding: 12px; border-radius: 6px; margin-bottom: 15px; text-align: center; font-size: 14px; }
        .alert.success { background: rgba(34,197,94,0.2); color: #4ade80; }
        .alert.error { background: rgba(239,68,68,0.2); color: #f87171; }
        .code-box { background: #0f172a; padding: 16px; border-radius: 8px; text-align: center; margin: 15px 0; font-size: 26px; font-weight: bold; letter-spacing: 5px; color: #fbbf24; border: 1px dashed #475569; }
        .links { text-align: center; margin-top: 22px; font-size: 14px; }
        a { color: #60a5fa; text-decoration: none; }
        hr { border: none; border-top: 1px solid #334155; margin: 25px 0; }
        .hint { font-size: 12px; color: #64748b; margin-top: 6px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo-wrap">
            <img src="/logo.png" alt="Mware Shop" onerror="this.onerror=null; this.src='/public/logo.png';">
        </div>
        <h1>🔑 Reset Password</h1>
        <p class="subtitle">Generate a code, then set your new password</p>

        <% if (message) { %>
            <div class="alert <%= success ? 'success' : 'error' %>"><%= message %></div>
        <% } %>

        <% if (generatedCode) { %>
            <div class="code-box"><%= generatedCode %></div>
            <p style="text-align:center; font-size:13px; color:#94a3b8; margin-bottom:20px;">
                Copy this code and use it below
            </p>
        <% } %>

        <form action="/forgot-password" method="POST">
            <input type="hidden" name="action" value="request">
            <div class="form-group">
                <label>Your Email Address</label>
                <input type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
            </div>
            <button type="submit" class="btn btn-secondary">Generate Verification Code</button>
        </form>

        <hr>

        <form action="/forgot-password" method="POST">
            <input type="hidden" name="action" value="reset">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
            </div>
            <div class="form-group">
                <label>Verification Code</label>
                <input type="text" name="verificationCode" placeholder="6-digit code" required>
                <div class="hint">Enter the code generated above</div>
            </div>
            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="newPassword" required>
            </div>
            <button type="submit" class="btn">Reset Password</button>
        </form>

        <div class="links">
            <p><a href="/login">← Back to Login</a></p>
            <p><a href="/">Back to Shop</a></p>
        </div>
    </div>
</body>
</html>
