<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Mware Shop</title>
    <style>
        body { background: #0f172a; color: #f8fafc; font-family: sans-serif; margin: 0; padding: 40px 20px; }
        .container { max-width: 420px; margin: 40px auto; background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 30px; }
        .logo-wrap { text-align: center; margin-bottom: 20px; }
        .logo-wrap img { height: 60px; width: auto; border-radius: 10px; }
        h1 { text-align: center; color: #fbbf24; margin-bottom: 20px; }
        .form-group { margin-bottom: 18px; position: relative; }
        label { display: block; font-size: 13px; margin-bottom: 5px; color: #94a3b8; font-weight: bold; }
        input { width: 100%; box-sizing: border-box; padding: 12px; background: #334155; border: 1px solid #475569; border-radius: 6px; color: white; }
        .toggle-pw { position: absolute; right: 12px; top: 38px; background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 13px; }
        .btn { width: 100%; padding: 14px; background: #10b981; border: none; color: white; font-weight: bold; font-size: 16px; border-radius: 8px; cursor: pointer; }
        .alert { background: rgba(239,68,68,0.2); color: #f87171; padding: 10px; border-radius: 6px; margin-bottom: 15px; text-align: center; }
        .links { text-align: center; margin-top: 22px; font-size: 14px; line-height: 1.8; }
        a { color: #60a5fa; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo-wrap">
            <img src="/logo.png" alt="Mware Shop" onerror="this.onerror=null; this.src='/public/logo.png';">
        </div>
        <h1>📝 Create Account</h1>
        <% if (message) { %><div class="alert"><%= message %></div><% } %>

        <form action="/register" method="POST">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" required>
            </div>
            <div class="form-group">
                <label>Phone Number</label>
                <input type="text" name="phone" required>
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" id="password" required>
                <button type="button" class="toggle-pw" onclick="togglePassword()">Show</button>
            </div>
            <button type="submit" class="btn">Register</button>
        </form>

        <div class="links">
            <p>Already have an account? <a href="/login">Login</a></p>
            <p><a href="/">← Back to Shop</a></p>
        </div>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('password');
            const btn = document.querySelector('.toggle-pw');
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = 'Hide';
            } else {
                input.type = 'password';
                btn.textContent = 'Show';
            }
        }
    </script>
</body>
</html>
