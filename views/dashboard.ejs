<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Mware Shop</title>
    <script src="https://tailwindcss.com"></script>
</head>
<body class="<%= theme.bg %> <%= theme.text %> min-h-screen font-sans">
    <!-- Navbar -->
    <nav class="bg-slate-950 p-4 border-b <%= theme.accent %> flex justify-between items-center shadow-lg">
        <div class="flex items-center gap-4">
            <a href="/" class="text-2xl font-extrabold tracking-wider text-white">MWARE SHOP</a>
            <% if (theme.name !== 'Standard') { %>
                <span class="px-2 py-0.5 rounded bg-amber-500 text-slate-950 text-xs font-black uppercase tracking-widest animate-pulse"><%= theme.name %> Mode</span>
            <% } %>
        </div>
        <div class="flex items-center gap-6">
            <a href="/" class="hover:text-indigo-400 font-medium">Shop</a>
            <a href="/checkout" class="relative hover:text-indigo-400 font-medium">
                Cart <span class="absolute -top-2 -right-4 bg-indigo-600 text-white text-xs px-1.5 rounded-full font-bold"><%= cartCount %></span>
            </a>
            <% if (user) { %>
                <% if (user.role === 'admin') { %><a href="/admin" class="text-amber-400 font-bold hover:underline">Admin Panel</a><% } %>
                <a href="/logout" class="text-sm bg-slate-800 px-3 py-1.5 rounded hover:bg-slate-700">Logout</a>
            <% } else { %>
                <a href="/login" class="bg-indigo-600 px-4 py-1.5 rounded font-bold hover:bg-indigo-700">Login</a>
            <% } %>
        </div>
    </nav>

    <!-- Main Dynamic Content Wrapper -->
    <main class="max-w-7xl mx-auto p-6 grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-3">
            <% if (activeTab === 'shop') { %>
                <!-- Products Grid -->
                <h2 class="text-3xl font-bold mb-6">Our Products</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <% products.forEach(product => { %>
                        <div class="bg-slate-800 rounded-xl overflow-hidden border border-slate-700 shadow-md flex flex-col justify-between">
                            <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-48 object-cover">
                            <div class="p-4 flex-1 flex flex-col justify-between">
                                <div>
                                    <h3 class="text-lg font-bold"><%= product.name %></h3>
                                    <p class="text-indigo-400 font-mono text-xl mt-1"><%= product.price %> <%= product.currency %></p>
                                    <span class="inline-block mt-2 px-2 py-0.5 text-xs font-semibold rounded <%= product.status === 'In Stock' ? 'bg-green-900/50 text-green-400' : 'bg-red-900/50 text-red-400' %>">
                                        <%= product.status %>
                                    </span>
                                </div>
                                <form action="/cart/add" method="POST" class="mt-4">
                                    <input type="hidden" name="productId" value="<%= product.id %>">
                                    <button type="submit" <%= product.status !== 'In Stock' ? 'disabled' : '' %> class="w-full py-2 bg-indigo-600 disabled:bg-slate-700 disabled:text-slate-500 hover:bg-indigo-700 rounded font-bold transition">
                                        <%= product.status === 'In Stock' ? 'Add to Cart' : 'Unavailable' %>
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else if (activeTab === 'checkout') { %>
                <!-- Checkout Module -->
                <h2 class="text-3xl font-bold mb-6">Your Cart Summary</h2>
                <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                    <% if (cart.length === 0) { %>
                        <p class="text-slate-400">Your cart is currently empty.</p>
                    <% } else { %>
                        <div class="divide-y divide-slate-700 mb-6">
                            <% cart.forEach(item => { %>
                                <div class="py-3 flex justify-between items-center">
                                    <span><%= item.name %></span>
                                    <span class="font-mono text-indigo-400"><%= item.price %> <%= item.currency %></span>
                                </div>
                            <% }) %>
                        </div>
                        <form action="/checkout/pay" method="POST">
                            <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold text-lg transition">Complete Payment</button>
                        </form>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- Sidebar (Widget, Contacts, QR Code Always Live) -->
        <aside class="space-y-6">
            <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 text-center flex flex-col items-center">
                <h4 class="font-bold text-sm mb-3 tracking-wide text-slate-400 uppercase">Scan to Visit Mobile Site</h4>
                <img src="<%= qrCode %>" alt="Site QR" class="w-36 h-36 bg-white p-2 rounded-lg shadow-inner">
            </div>
            <div class="bg-slate-800 p-5 rounded-xl border border-slate-700">
                <h4 class="font-bold text-sm mb-3 tracking-wide text-slate-400 uppercase">Contact Information</h4>
                <ul class="space-y-2 text-sm text-slate-300 font-mono">
                    <li><strong class="text-slate-400 font-sans block">Phone:</strong> <%= contactInfo.phone %></li>
                    <li><strong class="text-slate-400 font-sans block">Email:</strong> <%= contactInfo.email %></li>
                    <li><strong class="text-slate-400 font-sans block">Location:</strong> <%= contactInfo.address %></li>
                </ul>
            </div>
        </aside>
    </main>
</body>
</html>

