<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WELCOME TO MWARE SHOP</title>
    <link href="https://cloudflare.com" rel="stylesheet">
    <style>
        :root {
            --primary-action: #059669;
            --layout-bg: #f3f4f6;
            --surface-box: #ffffff;
            --text-main: #1f2937;
        }
        /* Theme configurations parsing structure engine styles */
        body.christmas { --primary-action: #dc2626; --layout-bg: #fef2f2; }
        body.diwali { --primary-action: #d97706; --layout-bg: #fffbeb; }
        
        body { font-family: system-ui, sans-serif; background: var(--layout-bg); margin: 0; color: var(--text-main); }
        .top-navbar { background: #111827; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
        .navbar-links a { color: white; text-decoration: none; margin-left: 20px; }
        .showcase-wrapper { max-width: 1200px; margin: 30px auto; padding: 0 20px; }
        .product-deck { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; }
        .product-module { background: var(--surface-box); border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); display: flex; flex-direction: column; }
        .product-image { width: 100%; height: 200px; object-fit: cover; background: #e5e7eb; }
        .product-details { padding: 20px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
        .action-button { background: var(--primary-action); color: white; border: none; width: 100%; padding: 10px; border-radius: 6px; font-weight: 600; cursor: pointer; margin-top: 10px; }
        .action-button:disabled { background: #9ca3af; cursor: not-allowed; }
        .theme-selector-box { background: #ffffff; padding: 15px; border-radius: 8px; margin-bottom: 25px; display: flex; gap: 15px; align-items: center; }
    </style>
</head>
<body class="<%= theme %>">

    <header class="top-navbar">
        <h2 style="margin: 0; cursor: pointer;" onclick="window.location.href='/'">Mware shop</h2>
        <nav class="navbar-links">
            <a href="/"><i class="fa fa-store"></i> HOME</a>
            <% if (user) { %>
                <a href="/orders"><i class="fa fa-boxes"></i> Account Orders</a>
                <% if (user.role === 'admin') { %>
                    <a href="/admin" style="color: #fbbf24;"><i class="fa fa-user-shield"></i> Control Matrix</a>
                <% } %>
                <a href="/logout" style="color: #f87171;"><i class="fa fa-sign-out-alt"></i> Out</a>
            <% } else { %>
                <a href="/login"><i class="fa fa-sign-in-alt"></i> Access Gateway</a>
            <% } %>
        </nav>
    </header>

    <main class="showcase-wrapper">
        <div class="theme-selector-box">
            <span><strong>Select Storefront Theme Layout Profile Canvas:</strong></span>
            <button onclick="applyThemeProfile('default')" class="action-button" style="width:auto; margin:0; background:#059669;">Standard Default</button>
            <button onclick="applyThemeProfile('christmas')" class="action-button" style="width:auto; margin:0; background:#f3f4f6; color:#1f2937;">Light Mode</button>
            <button onclick="applyThemeProfile('diwali')" class="action-button" style="width:auto; margin:0; background:#1f2937; color:#f9fafb;">Dark Mode</button>
        </div>

        <% if (activeTab === 'home') { %>
            <h3>Available In-Stock  Options</h3>
            <div class="product-deck">
                <% products.forEach(product => { %>
                    <div class="product-module">
                        <img src="<%= product.image_url %>" class="product-image" onerror="this.src='/uploads/default.jpg'" alt="Asset Image View">
                        <div class="product-details">
                            <div>
                                <h4 style="margin: 0 0 10px 0;"><%= product.name %></h4>
                                <p style="font-size: 14px; color: #4b5563; margin: 0 0 15px 0;"><%= product.description %></p>
                            </div>
                            <div>
                                <strong style="font-size: 18px; color: #111827;">Ksh <%= product.price %></strong>
                                <button class="action-button" 
                                        onclick="executeDirectCheckout('<%= product.price %>')"
                                        <%= product.status !== 'In Stock' ? 'disabled' : '' %>>
                                    <%= product.status === 'In Stock' ? 'Instant Purchase Settlement' : 'Stock Exhausted' %>
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else if (activeTab === 'orders') { %>
            <h3>Personal Account Historical Ledger Purchases</h3>
            <div style="background: white; border-radius: 8px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid #e5e7eb; text-align: left;">
                            <th style="padding: 12px;">Transaction Log ID</th>
                            <th style="padding: 12px;">Financial Commitment</th>
                            <th style="padding: 12px;">Processing Framework Stage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 12px;">#TXN-<%= order.id %></td>
                                <td style="padding: 12px;">Ksh <%= order.total_amount %></td>
                                <td style="padding: 12px;">
                                    <span style="padding: 4px 8px; border-radius: 4px; font-weight: bold; background: #f3f4f6;">
                                        <%= order.status %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </main>

    <script>
        function applyThemeProfile(themeName) {
            fetch('/theme/switch', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ theme: themeName })
            })
            .then(res => res.json())
            .then(data => { if(data.success) window.location.reload(); });
        }

        function executeDirectCheckout(itemValuationCost) {
            <% if (!user) { %>
                window.location.href = '/login';
                return;
            <% } %>

            if(!confirm("Authorize checkout allocation execution sequence for Ksh " + itemValuationCost + "?")) return;

            fetch('/orders/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount: itemValuationCost })
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                if(data.success) window.location.href = '/orders';
            });
        }
    </script>
</body>
</html>

