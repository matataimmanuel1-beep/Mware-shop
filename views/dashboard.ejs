<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Mware Shop</title>
    <style>
        body { background: #0f172a; color: #f8fafc; font-family: sans-serif; margin: 0; padding-bottom: 40px; }
        nav { background: #020617; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #6366f1; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .logo { font-size: 22px; font-weight: 800; color: #fff; text-decoration: none; letter-spacing: 1px; }
        .nav-links { display: flex; align-items: center; gap: 20px; }
        .nav-links a { color: #cbd5e1; text-decoration: none; font-weight: 500; font-size: 15px; }
        .nav-links a:hover { color: #6366f1; }
        .cart-link { position: relative; padding-right: 15px; }
        .badge { position: absolute; top: -8px; right: -5px; background: #6366f1; color: #fff; font-size: 11px; padding: 2px 6px; border-radius: 10px; font-weight: bold; }
        .logout-btn { background: #334155; padding: 6px 12px; border-radius: 4px; font-size: 14px; }
        .logout-btn:hover { background: #475569; }
        .container { max-width: 1200px; margin: 30px auto; padding: 0 20px; display: grid; grid-template-columns: 3fr 1fr; gap: 30px; }
        @media(max-width: 768px) { .container { grid-template-columns: 1fr; } }
        h2 { font-size: 28px; margin-top: 0; margin-bottom: 20px; color: #fff; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
        .card { background: #1e293b; border-radius: 10px; overflow: hidden; border: 1px solid #334155; display: flex; flex-col: column; justify-content: space-between; flex-direction: column; }
        .card img { width: 100%; height: 180px; object-fit: cover; }
        .card-body { padding: 15px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
        .card-title { font-size: 18px; font-weight: bold; margin: 0 0 10px 0; color: #fff; }
        .price { font-family: monospace; font-size: 20px; color: #818cf8; margin: 0 0 10px 0; font-weight: bold; }
        .status { inline-size: max-content; padding: 2px 8px; font-size: 11px; font-weight: bold; border-radius: 4px; background: rgba(34,197,94,0.15); color: #4ade80; }
        .status.out { background: rgba(239,68,68,0.15); color: #f87171; }
        .buy-btn { width: 100%; padding: 10px; background: #6366f1; border: none; border-radius: 6px; color: #fff; font-weight: bold; cursor: pointer; margin-top: 15px; }
        .buy-btn:disabled { background: #334155; color: #64748b; cursor: not-allowed; }
        aside { display: flex; flex-direction: column; gap: 20px; }
        .side-box { background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 20px; text-align: center; }
        .side-box h4 { margin: 0 0 15px 0; font-size: 12px; text-transform: uppercase; color: #94a3b8; letter-spacing: 1px; }
        .qr-img { background: white; padding: 8px; border-radius: 8px; width: 130px; height: 130px; margin: 0 auto; display: block; }
        .contact-list { text-align: left; padding: 0; margin: 0; list-style: none; font-size: 14px; color: #cbd5e1; font-family: monospace; }
        .contact-list li { margin-bottom: 12px; }
        .contact-list strong { display: block; color: #94a3b8; font-family: sans-serif; font-size: 12px; margin-bottom: 2px; }
        .checkout-box { background: #1e293b; padding: 20px; border-radius: 10px; border: 1px solid #334155; }
        .line-item { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #334155; }
        .pay-btn { width: 100%; padding: 12px; background: #10b981; border: none; color: white; font-weight: bold; border-radius: 6px; cursor: pointer; font-size: 16px; margin-top: 20px; }
    </style>
</head>
<body>
    <nav style="border-color: <%= theme.accent === 'border-green-500' ? '#22c55e' : theme.accent === 'border-orange-500' ? '#f97316' : '#6366f1' %>">
        <div style="display: flex; align-items: center; gap: 15px;">
            <a href="/" class="logo">MWARE SHOP</a>
            <% if (theme.name !== 'Standard') { %>
                <span style="background:#f59e0b; color:#000; padding:2px 6px; font-size:11px; font-weight:bold; border-radius:4px;"><%= theme.name %> MODE</span>
            <% } %>
        </div>
        <div class="nav-links">
            <a href="/">Shop</a>
            <a href="/checkout" class="cart-link">Cart <span class="badge"><%= cartCount %></span></a>
            <% if (user) { %>
                <% if (user.role === 'admin') { %><a href="/admin" style="color:#fbbf24; font-weight:bold;">Admin Panel</a><% } %>
                <a href="/logout" class="logout-btn">Logout</a>
            <% } else { %>
                <a href="/login" style="background:#6366f1; padding:6px 15px; border-radius:4px; color:white; font-weight:bold;">Login</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <div>
            <% if (activeTab === 'shop') { %>
                <h2>Our Products</h2>
                <div class="grid">
                    <% products.forEach(product => { %>
                        <div class="card">
                            <img src="<%= product.image %>" alt="<%= product.name %>">
                            <div class="card-body">
                                <div>
                                    <div class="card-title"><%= product.name %></div>
                                    <div class="price"><%= product.price %> <%= product.currency %></div>
                                    <div class="status <%= product.status !== 'In Stock' ? 'out' : '' %>"><%= product.status %></div>
                                </div>
                                <form action="/cart/add" method="POST">
                                    <input type="hidden" name="productId" value="<%= product.id %>">
                                    <button type="submit" class="buy-btn" <%= product.status !== 'In Stock' ? 'disabled' : '' %>><%= product.status === 'In Stock' ? 'Add to Cart' : 'Out of Stock' %></button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else if (activeTab === 'checkout') { %>
                <h2>Your Cart Summary</h2>
                <div class="checkout-box">
                    <% if (cart.length === 0) { %>
                        <p style="color:#94a3b8; margin:0;">Your shopping cart is empty.</p>
                    <% } else { %>
                        <% cart.forEach(item => { %>
                            <div class="line-item">
                                <span><%= item.name %></span>
                                <span style="font-family:monospace; color:#818cf8;"><%= item.price %> <%= item.currency %></span>
                            </div>
                        <% }) %>
                        <form action="/checkout/pay" method="POST">
                            <button type="submit" class="pay-btn">Complete Payment Order</button>
                        </form>
                    <% } %>
                </div>
            <% } %>
        </div>

        <aside>
            <div class="side-box">
                <h4>Scan QR Code</h4>
                <% if (qrCode) { %>
                    <img src="<%= qrCode %>" class="qr-img" alt="QR Link">
                <% } %>
            </div>
            <div class="side-box">
                <h4>Contact Matrix</h4>
                <ul class="contact-list">
                    <li><strong>Phone Line:</strong><%= contactInfo.phone %></li>
                    <li><strong>Email:</strong><%= contactInfo.email %></li>
                    <li><strong>Location HQ:</strong><%= contactInfo.address %></li>
                </ul>
            </div>
        </aside>
    </div>
</body>
</html>
