<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mware Shop</title>
    <style>
        body { background: <%= theme.bg %>; color: <%= theme.text %>; font-family: sans-serif; margin: 0; padding-bottom: 50px; }
        nav { background: #020617; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid <%= theme.accent %>; flex-wrap: wrap; gap: 10px; }
        .logo { font-size: 20px; font-weight: 900; color: #fff; text-decoration: none; }
        .nav-links { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
        .nav-links a { color: #cbd5e1; text-decoration: none; font-size: 13px; font-weight: bold; }
        .badge { background: <%= theme.accent %>; color: #fff; font-size: 11px; padding: 2px 6px; border-radius: 10px; margin-left: 4px; }
        .container { max-width: 1200px; margin: 20px auto; padding: 0 12px; display: grid; grid-template-columns: 3fr 1fr; gap: 25px; }
        .box { background: <%= theme.cardBg %>; border: 1px solid #334155; border-radius: 10px; padding: 16px; margin-bottom: 20px; }

        /* 7 products per row on phone */
        .grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
        }
        .prod-card {
            background: #1e293b;
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid #334155;
            display: flex;
            flex-direction: column;
        }
        .prod-card img {
            width: 100%;
            height: 65px;
            object-fit: cover;
        }
        .p-body {
            padding: 5px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .card-title {
            font-size: 10px;
            font-weight: bold;
            color: white;
            margin-bottom: 2px;
            line-height: 1.2;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .price {
            font-family: monospace;
            font-size: 11px;
            color: <%= theme.accent %>;
            font-weight: bold;
        }
        .status {
            padding: 1px 4px;
            font-size: 8px;
            font-weight: bold;
            background: rgba(34,197,94,0.2);
            color: #4ade80;
            border-radius: 3px;
            width: max-content;
            margin-top: 2px;
        }
        .status.out { background: rgba(239,68,68,0.2); color: #f87171; }
        .btn {
            width: 100%;
            padding: 4px;
            background: <%= theme.btn %>;
            border: none;
            color: white;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            margin-top: 4px;
            font-size: 9px;
        }

        @media (min-width: 600px) {
            .grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; }
            .prod-card img { height: 100px; }
            .card-title { font-size: 13px; }
            .price { font-size: 14px; }
            .btn { padding: 8px; font-size: 12px; }
        }
        @media (min-width: 900px) {
            .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
            .prod-card img { height: 130px; }
        }

        .category-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
        .cat-btn { padding: 5px 12px; background: #334155; color: #e2e8f0; border-radius: 20px; text-decoration: none; font-size: 12px; }
        .cat-btn.active { background: <%= theme.accent %>; color: #000; font-weight: bold; }
        .form-group { margin-bottom: 12px; }
        label { display: block; font-size: 12px; margin-bottom: 4px; color: #94a3b8; font-weight: bold; }
        input, select, textarea { width: 100%; box-sizing: border-box; padding: 10px; background: #0f172a; border: 1px solid #334155; border-radius: 4px; color: white; }
        .split-checkout { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .summary-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; border-bottom: 1px dashed #334155; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { padding: 10px 8px; border-bottom: 1px solid #334155; }
        th { color: #94a3b8; background: #0f172a; }
        .notif { background: #1e293b; border-left: 4px solid <%= theme.accent %>; padding: 10px 14px; margin-bottom: 8px; border-radius: 0 6px 6px 0; font-size: 13px; }
        .qr-box { text-align: center; }
        .qr-box img { background: white; padding: 8px; border-radius: 8px; }

        @media(max-width: 768px) {
            .container { grid-template-columns: 1fr; }
            .split-checkout { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <nav>
        <div style="display:flex; align-items:center; gap:10px;">
            <a href="/" class="logo">MWARE SHOP</a>
            <% if (user && user.role === 'admin') { %>
                <span style="font-size:10px; background:<%= theme.accent %>; color:#000; padding:2px 6px; border-radius:4px; font-weight:bold;"><%= theme.name %></span>
            <% } %>
        </div>
        <div class="nav-links">
            <a href="/">Catalog</a>
            <a href="/checkout">Cart <span class="badge"><%= cartCount %></span></a>
            <% if (user) { %>
                <% if (user.role === 'admin') { %>
                    <a href="/admin" style="color:#fbbf24;">Admin</a>
                    <a href="/switch-view" style="color:#34d399;">Switch View</a>
                <% } %>
                <a href="/profile" style="color:<%= theme.accent %>;">Account</a>
                <a href="/logout" style="background:#334155; padding:4px 10px; border-radius:4px;">Logout</a>
            <% } else { %>
                <a href="/login" style="background:<%= theme.btn %>; padding:6px 14px; border-radius:4px;">Login</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <div>
            <% if (activeTab === 'shop') { %>
                <h2 style="margin-top:0;">Available Inventory</h2>

                <div class="category-bar">
                    <a href="/" class="cat-btn <%= !selectedCategory ? 'active' : '' %>">All</a>
                    <% if (typeof categories !== 'undefined') { %>
                        <% categories.forEach(c => { %>
                            <a href="/?category=<%= encodeURIComponent(c.category) %>" class="cat-btn <%= selectedCategory === c.category ? 'active' : '' %>">
                                <%= c.category %>
                            </a>
                        <% }) %>
                    <% } %>
                </div>

                <div class="grid">
                    <% products.forEach(p => { %>
                        <div class="prod-card">
                            <a href="/product/<%= p.id %>">
                                <img src="<%= p.image %>" alt="<%= p.name %>" onerror="this.src='https://via.placeholder.com/300'">
                            </a>
                            <div class="p-body">
                                <div>
                                    <a href="/product/<%= p.id %>" style="text-decoration:none;">
                                        <div class="card-title"><%= p.name %></div>
                                    </a>
                                    <div class="price"><%= p.price %> <%= p.currency %></div>
                                    <div class="status <%= p.status !== 'In Stock' ? 'out' : '' %>"><%= p.status %></div>
                                </div>
                                <form action="/cart/add" method="POST">
                                    <input type="hidden" name="productId" value="<%= p.id %>">
                                    <button type="submit" class="btn">Add</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>

            <% } else if (activeTab === 'checkout') { %>
                <h2>Secure Checkout</h2>
                <% if (!cart || cart.length === 0) { %>
                    <div class="box"><p style="color:#94a3b8;">Your cart is empty.</p></div>
                <% } else { %>
                    <div class="split-checkout">
                        <div class="box">
                            <h3>Shipping Form</h3>
                            <form action="/checkout/pay" method="POST">
                                <input type="hidden" name="totalAmount" value="<%= financials.total %>">
                                <input type="hidden" name="totalCurrency" value="<%= financials.currency %>">
                                <div class="form-group"><label>Full Name</label><input type="text" name="fullName" required></div>
                                <div class="form-group"><label>Shipping Address</label><textarea name="shippingAddress" rows="2" required></textarea></div>
                                <div class="form-group">
                                    <label>Payment Method</label>
                                    <select name="gatewayMethod">
                                        <option value="M-Pesa Express">M-Pesa</option>
                                        <option value="Credit Card">Visa / Mastercard</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn" style="background:#10b981; padding:12px; font-size:14px;">Place Order</button>
                            </form>
                        </div>
                        <div class="box">
                            <h3>Order Summary</h3>
                            <% cart.forEach(c => { %>
                                <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:13px;">
                                    <span><%= c.name %></span>
                                    <span><%= c.price %> <%= financials.currency %></span>
                                </div>
                            <% }) %>
                            <div style="border-top:1px solid #334155; margin-top:12px; padding-top:8px;">
                                <div class="summary-row"><span>Subtotal</span><span><%= financials.subtotal %></span></div>
                                <div class="summary-row"><span>Tax (16%)</span><span><%= financials.tax %></span></div>
                                <div class="summary-row" style="border:none; font-weight:bold; font-size:16px;">
                                    <span>Total</span><span><%= financials.total %> <%= financials.currency %></span>
                                </div>
                                <p style="font-size:12px; color:#94a3b8; margin-top:10px;">
                                    * Final total (including transport) will be confirmed by Admin
                                </p>
                            </div>
                        </div>
                    </div>
                <% } %>

            <% } else if (activeTab === 'profile') { %>
                <h2>My Account</h2>

                <div class="box">
                    <h3>Notifications</h3>
                    <% if (!notifications || notifications.length === 0) { %>
                        <p style="color:#94a3b8;">No notifications yet.</p>
                    <% } else { %>
                        <% notifications.forEach(n => { %>
                            <div class="notif">
                                <%= n.message %><br>
                                <small style="color:#64748b;"><%= new Date(n.created_at).toLocaleString() %></small>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <div class="box">
                    <h3>My Orders</h3>
                    <% if (!customerOrders || customerOrders.length === 0) { %>
                        <p style="color:#94a3b8;">No orders yet.</p>
                    <% } else { %>
                        <div style="overflow-x:auto;">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Date</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% customerOrders.forEach(ord => { %>
                                        <tr>
                                            <td style="font-family:monospace;"><%= ord.id %></td>
                                            <td><%= ord.date %></td>
                                            <td><%= ord.items %></td>
                                            <td><%= ord.total %> <%= ord.currency %></td>
                                            <td>
                                                <span style="padding:2px 6px; border-radius:4px; font-size:11px; font-weight:bold;
                                                    background: <%= ord.status==='Delivered' ? 'rgba(34,197,94,0.15)' : ord.status==='Shipped' ? 'rgba(59,130,246,0.15)' : 'rgba(234,179,8,0.15)' %>;
                                                    color: <%= ord.status==='Delivered' ? '#4ade80' : ord.status==='Shipped' ? '#60a5fa' : '#facc15' %>;">
                                                    <%= ord.status %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>

        <div>
            <div class="box">
                <h4 style="margin:0 0 10px 0; font-size:12px; color:#94a3b8; text-transform:uppercase;">Store Support</h4>
                <div style="font-size:13px; line-height:1.7;">
                    <strong>Ph:</strong> <%= contactInfo.phone %><br>
                    <strong>Em:</strong> <%= contactInfo.email %><br>
                    <strong>HQ:</strong> <%= contactInfo.address %>
                </div>
            </div>

            <% if (user) { %>
                <div class="box qr-box">
                    <h4 style="margin:0 0 12px 0; font-size:12px; color:#94a3b8; text-transform:uppercase;">Site QR & Link</h4>
                    <% if (typeof qrCode !== 'undefined' && qrCode) { %>
                        <img src="<%= qrCode %>" alt="QR Code" width="130">
                    <% } %>
                    <p style="font-size:12px; word-break:break-all; margin-top:10px;">
                        <a href="<%= typeof siteUrl !== 'undefined' ? siteUrl : '/' %>" style="color:#60a5fa;">
                            <%= typeof siteUrl !== 'undefined' ? siteUrl : '' %>
                        </a>
                    </p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
