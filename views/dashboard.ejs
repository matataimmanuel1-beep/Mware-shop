<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mware Shop</title>
    <style>
        body { background: <%= theme.bg %>; color: <%= theme.text %>; font-family: sans-serif; margin: 0; padding-bottom: 50px; }
        nav { background: #020617; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid <%= theme.accent %>; flex-wrap: wrap; gap: 10px; }
        .logo { font-size: 20px; font-weight: 900; color: #fff; text-decoration: none; }
        .nav-links { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
        .nav-links a { color: #cbd5e1; text-decoration: none; font-size: 13px; font-weight: bold; }
        .badge { background: <%= theme.accent %>; color: #fff; font-size: 11px; padding: 2px 6px; border-radius: 10px; margin-left: 4px; }
        .container { max-width: 1200px; margin: 20px auto; padding: 0 12px; display: grid; grid-template-columns: 3fr 1fr; gap: 25px; }
        .box { background: <%= theme.cardBg %>; border: 1px solid #334155; border-radius: 10px; padding: 16px; margin-bottom: 20px; }

        .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
        .prod-card { background: #1e293b; border-radius: 6px; overflow: hidden; border: 1px solid #334155; display: flex; flex-direction: column; }
        .prod-card img { width: 100%; height: 65px; object-fit: cover; }
        .p-body { padding: 5px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
        .card-title { font-size: 10px; font-weight: bold; color: white; margin-bottom: 2px; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .price { font-family: monospace; font-size: 11px; color: <%= theme.accent %>; font-weight: bold; }
        .status { padding: 1px 4px; font-size: 8px; font-weight: bold; background: rgba(34,197,94,0.2); color: #4ade80; border-radius: 3px; width: max-content; margin-top: 2px; }
        .status.out { background: rgba(239,68,68,0.2); color: #f87171; }
        .btn { width: 100%; padding: 4px; background: <%= theme.btn %>; border: none; color: white; font-weight: bold; border-radius: 4px; cursor: pointer; margin-top: 4px; font-size: 9px; }

        @media (min-width: 600px) {
            .grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; }
            .prod-card img { height: 100px; }
            .card-title { font-size: 13px; }
            .price { font-size: 14px; }
            .btn { padding: 8px; font-size: 12px; }
        }
        @media (min-width: 900px) {
            .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
            .prod-card img { height: 130px; }
        }

        .category-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
        .cat-btn { padding: 5px 12px; background: #334155; color: #e2e8f0; border-radius: 20px; text-decoration: none; font-size: 12px; }
        .cat-btn.active { background: <%= theme.accent %>; color: #000; font-weight: bold; }
        .form-group { margin-bottom: 12px; }
        label { display: block; font-size: 12px; margin-bottom: 4px; color: #94a3b8; font-weight: bold; }
        input, select, textarea { width: 100%; box-sizing: border-box; padding: 10px; background: #0f172a; border: 1px solid #334155; border-radius: 4px; color: white; }
        .split-checkout { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .summary-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; border-bottom: 1px dashed #334155; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { padding: 10px 8px; border-bottom: 1px solid #334155; }
        th { color: #94a3b8; background: #0f172a; }
        .notif { background: #1e293b; border-left: 4px solid <%= theme.accent %>; padding: 10px 14px; margin-bottom: 8px; border-radius: 0 6px 6px 0; font-size: 13px; display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .qr-box { text-align: center; }
        .qr-box img { background: white; padding: 8px; border-radius: 8px; }
        .action { background: #334155; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 11px; }
        .profile-img { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; border: 2px solid <%= theme.accent %>; }
        .till-box { background: #0f172a; padding: 14px; border-radius: 8px; margin-bottom: 14px; text-align: center; border: 1px solid #334155; }

        @media(max-width: 768px) {
            .container { grid-template-columns: 1fr; }
            .split-checkout { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <nav>
        <div style="display:flex; align-items:center; gap:10px;">
            <a href="/" class="logo" style="display:flex; align-items:center; gap:8px; text-decoration:none;">
    <img src="/public/logo.png" alt="Mware Shop" style="height:36px; width:auto; border-radius:6px;">
    <span style="font-size:18px; font-weight:900; color:#fff;">MWARE SHOP</span>
</a>
            <% if (user && user.role === 'admin') { %>
                <span style="font-size:10px; background:<%= theme.accent %>; color:#000; padding:2px 6px; border-radius:4px; font-weight:bold;"><%= theme.name %></span>
            <% } %>
        </div>
        <div class="nav-links">
            <a href="/">Catalog</a>
            <a href="/checkout">Cart <span class="badge"><%= cartCount %></span></a>
            <% if (user) { %>
                <% if (user.role === 'admin') { %>
                    <a href="/admin" style="color:#fbbf24;">Admin</a>
                    <a href="/switch-view" style="color:#34d399;">Switch View</a>
                <% } %>
                <a href="/profile" style="color:<%= theme.accent %>;">Account</a>
                <a href="/logout" style="background:#334155; padding:4px 10px; border-radius:4px;">Logout</a>
            <% } else { %>
                <a href="/login" style="background:<%= theme.btn %>; padding:6px 14px; border-radius:4px;">Login</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <div>
            <% if (activeTab === 'shop') { %>
                <h2 style="margin-top:0;">Available Inventory</h2>

                <div class="category-bar">
                    <a href="/" class="cat-btn <%= !selectedCategory ? 'active' : '' %>">All</a>
                    <% if (typeof categories !== 'undefined' && categories) { %>
                        <% categories.forEach(c => { %>
                            <a href="/?category=<%= encodeURIComponent(c.category) %>" class="cat-btn <%= selectedCategory === c.category ? 'active' : '' %>">
                                <%= c.category %>
                            </a>
                        <% }) %>
                    <% } %>
                </div>

                <div class="grid">
                    <% products.forEach(p => { %>
                        <div class="prod-card">
                            <a href="/product/<%= p.id %>">
                                <img src="<%= p.image %>" alt="<%= p.name %>" onerror="this.src='https://via.placeholder.com/300'">
                            </a>
                            <div class="p-body">
                                <div>
                                    <a href="/product/<%= p.id %>" style="text-decoration:none;">
                                        <div class="card-title"><%= p.name %></div>
                                    </a>
                                    <div class="price"><%= p.price %> <%= p.currency %></div>
                                    <div class="status <%= p.status !== 'In Stock' ? 'out' : '' %>"><%= p.status %></div>
                                </div>
                                <form action="/cart/add" method="POST">
                                    <input type="hidden" name="productId" value="<%= p.id %>">
                                    <button type="submit" class="btn">Add</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>

            <% } else if (activeTab === 'checkout') { %>
                <h2>Secure Checkout</h2>
                <% if (!cart || cart.length === 0) { %>
                    <div class="box"><p style="color:#94a3b8;">Your cart is empty.</p></div>
                <% } else { %>
                    <div class="split-checkout">
                        <div class="box">
                            <h3>Shipping Form</h3>
                            <form action="/checkout/pay" method="POST">
                                <input type="hidden" name="totalAmount" value="<%= financials.total %>">
                                <input type="hidden" name="totalCurrency" value="<%= financials.currency %>">
                                <div class="form-group"><label>Full Name</label><input type="text" name="fullName" required></div>
                                <div class="form-group"><label>Shipping Address</label><textarea name="shippingAddress" rows="2" required></textarea></div>
                                <div class="form-group">
                                    <label>Payment Method</label>
                                    <select name="gatewayMethod" id="payMethod" onchange="showTill()">
                                        <option value="M-Pesa Till">M-Pesa Till</option>
                                        <option value="Cash">Cash on Delivery</option>
                                        <option value="Credit Card">Visa / Mastercard</option>
                                    </select>
                                </div>
                                <div id="tillBox" class="till-box">
                                    <p style="margin:0; font-size:13px; color:#94a3b8;">Pay to M-Pesa Till Number</p>
                                    <p style="margin:8px 0 0; font-size:24px; font-weight:bold; color:#22c55e; letter-spacing:3px;">9507049</p>
                                </div>
                                <button type="submit" class="btn" style="background:#10b981; padding:12px; font-size:14px;">Place Order</button>
                            </form>
                        </div>
                        <div class="box">
                            <h3>Order Summary</h3>
                            <% cart.forEach(c => { %>
                                <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:13px;">
                                    <span><%= c.name %></span>
                                    <span><%= c.price %> <%= financials.currency %></span>
                                </div>
                            <% }) %>
                            <div style="border-top:1px solid #334155; margin-top:12px; padding-top:8px;">
                                <div class="summary-row"><span>Subtotal</span><span><%= financials.subtotal %></span></div>
                                <div class="summary-row" style="border:none; font-weight:bold; font-size:16px;">
                                    <span>Total</span><span><%= financials.total %> <%= financials.currency %></span>
                                </div>
                                <p style="font-size:12px; color:#94a3b8; margin-top:10px;">
                                    * Admin will confirm final total (including transport if any)
                                </p>
                            </div>
                        </div>
                    </div>
                <% } %>

            <% } else if (activeTab === 'profile') { %>
                <h2>My Account</h2>

                <!-- Store Owner Details -->
                <div class="box">
                    <h3>Store Owner Details</h3>
                    <p style="margin:6px 0;"><strong>Phone:</strong> <%= contactInfo.phone %></p>
                    <p style="margin:6px 0;"><strong>Email:</strong> <%= contactInfo.email %></p>
                    <p style="margin:6px 0;"><strong>Address:</strong> <%= contactInfo.address %></p>
                </div>

                <!-- Profile -->
                <div class="box">
                    <h3>My Profile</h3>
                    <% if (account && account.profile_image) { %>
                        <img src="<%= account.profile_image %>" class="profile-img" alt="Profile">
                    <% } %>
                    <form action="/profile/update-full" method="POST" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Phone</label>
                            <input type="text" name="phone" value="<%= account && account.phone ? account.phone : '' %>">
                        </div>
                        <div class="form-group">
                            <label>New Password (leave blank to keep current)</label>
                            <input type="password" name="newPassword" placeholder="Type new password">
                        </div>
                        <div class="form-group">
                            <label>Profile Photo</label>
                            <input type="file" name="profileImage" accept="image/*">
                        </div>
                        <button type="submit" class="btn" style="background:#10b981; padding:10px; font-size:13px;">Save Profile</button>
                    </form>
                </div>

                <!-- Notifications -->
                <div class="box">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                        <h3 style="margin:0;">Notifications</h3>
                        <form action="/notifications/clear" method="POST">
                            <button type="submit" class="btn" style="width:auto; padding:6px 12px; font-size:12px; background:#991b1b;">Clear All</button>
                        </form>
                    </div>
                    <% if (!notifications || notifications.length === 0) { %>
                        <p style="color:#94a3b8;">No notifications.</p>
                    <% } else { %>
                        <% notifications.forEach(n => { %>
                            <div class="notif">
                                <div>
                                    <%= n.message %><br>
                                    <small style="color:#64748b;"><%= new Date(n.created_at).toLocaleString() %></small>
                                </div>
                                <form action="/notifications/delete/<%= n.id %>" method="POST">
                                    <button type="submit" class="action" style="background:#991b1b;">Delete</button>
                                </form>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <!-- Orders -->
                <div class="box">
                    <h3>My Orders</h3>
                    <% if (!customerOrders || customerOrders.length === 0) { %>
                        <p style="color:#94a3b8;">No orders yet.</p>
                    <% } else { %>
                        <div style="overflow-x:auto;">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Date</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% customerOrders.forEach(ord => { %>
                                        <tr>
                                            <td style="font-family:monospace;"><%= ord.id %></td>
                                            <td><%= ord.date %></td>
                                            <td><%= ord.items %></td>
                                            <td><%= ord.total %> <%= ord.currency %></td>
                                            <td>
                                                <span style="padding:2px 6px; border-radius:4px; font-size:11px; font-weight:bold;
                                                    background: <%= ord.status==='Delivered' ? 'rgba(34,197,94,0.15)' : ord.status==='Shipped' ? 'rgba(59,130,246,0.15)' : 'rgba(234,179,8,0.15)' %>;
                                                    color: <%= ord.status==='Delivered' ? '#4ade80' : ord.status==='Shipped' ? '#60a5fa' : '#facc15' %>;">
                                                    <%= ord.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if (ord.status === 'Shipped') { %>
                                                    <form action="/orders/confirm-delivery" method="POST">
                                                        <input type="hidden" name="orderId" value="<%= ord.id %>">
                                                        <button type="submit" class="btn" style="width:auto; padding:5px 10px; font-size:11px; background:#10b981;">Confirm Delivery</button>
                                                    </form>
                                                <% } else { %>—<% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- Sidebar -->
        <div>
            <div class="box">
                <h4 style="margin:0 0 10px 0; font-size:12px; color:#94a3b8; text-transform:uppercase;">Store Support</h4>
                <div style="font-size:13px; line-height:1.7;">
                    <strong>Ph:</strong> <%= contactInfo.phone %><br>
                    <strong>Em:</strong> <%= contactInfo.email %><br>
                    <strong>HQ:</strong> <%= contactInfo.address %>
                </div>
            </div>

            <% if (user) { %>
                <div class="box qr-box">
                    <h4 style="margin:0 0 12px 0; font-size:12px; color:#94a3b8; text-transform:uppercase;">Site QR & Link</h4>
                    <% if (typeof qrCode !== 'undefined' && qrCode) { %>
                        <img src="<%= qrCode %>" alt="QR Code" width="130">
                    <% } %>
                    <p style="font-size:12px; word-break:break-all; margin-top:10px;">
                        <a href="<%= typeof siteUrl !== 'undefined' ? siteUrl : '/' %>" style="color:#60a5fa;">
                            <%= typeof siteUrl !== 'undefined' ? siteUrl : '' %>
                        </a>
                    </p>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function showTill() {
            const val = document.getElementById('payMethod');
            const box = document.getElementById('tillBox');
            if (val && box) {
                box.style.display = val.value === 'M-Pesa Till' ? 'block' : 'none';
            }
        }
        // Popup latest notification once
        <% if (activeTab === 'profile' && typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
        if (!sessionStorage.getItem('notif_shown')) {
            alert("Notification: <%= notifications[0].message.replace(/"/g, '\\"').replace(/'/g, "\\'") %>");
            sessionStorage.setItem('notif_shown', '1');
        }
        <% } %>
    </script>
</body>
</html>
